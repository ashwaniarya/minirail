{
  "deployment": {
    "metadata": {
      "name": "hello",
      "namespace": "apps",
      "labels": {
        "paas/app": "hello"
      }
    },
    "spec": {
      "replicas": 2,
      "selector": {
        "matchLabels": {
          "paas/app": "hello"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "paas/app": "hello"
          },
          "annotations": {
            "paas/restarted-at": "2026-10-15T00:00:00Z"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "app",
              "image": "registry.digitalocean.com/acme/hello:abc",
              "envFrom": [
                {
                  "secretRef": {
                    "name": "hello-env",
                    "optional": true
                  }
                },
                {
                  "secretRef": {
                    "name": "hello-db",
                    "optional": true
                  }
                }
              ],
              "resources": {
                "limits": {
                  "memory": "512Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "128Mi"
                }
              }
            }
          ],
          "imagePullSecrets": [
            {
              "name": "registry"
            }
          ]
        }
      },
      "strategy": {
        "type": "RollingUpdate",
        "rollingUpdate": {
          "maxUnavailable": 0,
          "maxSurge": 1
        }
      }
    },
    "status": {}
  }
}