{
  "deployment": {
    "metadata": {
      "name": "hello",
      "namespace": "apps",
      "labels": {
        "paas/app": "hello"
      }
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "paas/app": "hello",
          "paas/kind": "web"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "paas/app": "hello",
            "paas/kind": "web"
          },
          "annotations": {
            "paas/restarted-at": "2026-10-15T00:00:00Z"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "app",
              "image": "registry.digitalocean.com/acme/hello:abc",
              "ports": [
                {
                  "name": "http",
                  "containerPort": 8080
                }
              ],
              "envFrom": [
                {
                  "secretRef": {
                    "name": "hello-env",
                    "optional": true
                  }
                },
                {
                  "secretRef": {
                    "name": "hello-db",
                    "optional": true
                  }
                }
              ],
              "env": [
                {
                  "name": "PORT",
                  "value": "8080"
                }
              ],
              "resources": {
                "limits": {
                  "memory": "512Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "128Mi"
                }
              },
              "readinessProbe": {
                "tcpSocket": {
                  "port": 8080
                },
                "periodSeconds": 5
              }
            }
          ],
          "imagePullSecrets": [
            {
              "name": "registry"
            }
          ]
        }
      },
      "strategy": {
        "type": "RollingUpdate",
        "rollingUpdate": {
          "maxUnavailable": 0,
          "maxSurge": 1
        }
      }
    },
    "status": {}
  },
  "service": {
    "metadata": {
      "name": "hello",
      "namespace": "apps",
      "labels": {
        "paas/app": "hello"
      }
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 80,
          "targetPort": 8080
        }
      ],
      "selector": {
        "paas/app": "hello",
        "paas/kind": "web"
      }
    },
    "status": {
      "loadBalancer": {}
    }
  },
  "ingress": {
    "metadata": {
      "name": "hello",
      "namespace": "apps",
      "labels": {
        "paas/app": "hello"
      }
    },
    "spec": {
      "ingressClassName": "traefik",
      "rules": [
        {
          "host": "hello.apps.example.com",
          "http": {
            "paths": [
              {
                "path": "/",
                "pathType": "Prefix",
                "backend": {
                  "service": {
                    "name": "hello",
                    "port": {
                      "number": 80
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "status": {
      "loadBalancer": {}
    }
  }
}